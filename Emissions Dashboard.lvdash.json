{
  "datasets": [
    {
      "name": "75ec0e44",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,\r\n",
        "longitude,\r\n",
        "`GHG emissions mtons CO2e` as Emissions\r\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "eaeffce1",
      "displayName": "county emissions and population impact overview",
      "queryLines": [
        "SELECT county_state_name AS county,\r\n",
        "       population,\r\n",
        "       CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS total_emissions_mtons_co2e,\r\n",
        "       ROUND(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population, 2) AS emissions_per_person_mtons_co2e\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "ORDER BY emissions_per_person_mtons_co2e DESC"
      ]
    },
    {
      "name": "2290e486",
      "displayName": "Top 10 States by GHG Emissions in Metric Tons",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "       ROUND(SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)), 2) AS Total_emissions\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_emissions DESC\r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "bea9b783",
      "displayName": "Top Ten Counties by Carbon Emissions and Population",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS Total_emissions\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "ORDER BY Total_emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
